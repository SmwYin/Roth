      "original_execution_request": {
        "code": "import Mathlib.Algebra.MonoidAlgebra.Degree\nimport Mathlib.Algebra.MvPolynomial.Eval\nimport Mathlib.Order.ConditionallyCompleteLattice.Finset\nimport Mathlib.Basic.Real.Basic\nimport Mathlib.Data.Finsupp.Weight\nimport Mathlib.RingTheory.MvPowerSeries.NoZeroDivisors\nimport Mathlib.Tactic\nimport Mathlib.Algebra.Polynomial.RingDivision\nimport Mathlib.Algebra.Polynomial.Taylor\nimport Mathlib.Algebra.MvPolynomial.NoZeroDivisors\nimport Mathlib.LinearAlgebra.FreeModule.PID\nimport Mathlib.RingTheory.MvPolynomial.Localization\nimport Mathlib.RingTheory.Localization.Integer\nimport Mathlib.RingTheory.Localization.FractionRing\nimport Mathlib.RingTheory.Polynomial.GaussLemma\n#check_failure Roth.RSet\nnamespace RSet179Isolated\nopen MvPolynomial\n#check MvPolynomial.restrictSupport\n#check MvPolynomial.mem_restrictSupport_iff\n#check MvPolynomial.basisRestrictSupport\n#check MvPolynomial.restrictSupport_add\n#check MvPolynomial.mem_restrictDegree\n#check MvPolynomial.degreeOf_le_iff\ntheorem degree_support_bridge {σ : Type*} {R : Type*} [CommSemiring R]\n    (P : MvPolynomial σ R) (r : σ → ℕ) :\n    (∀ j, degreeOf j P ≤ r j) ↔\n      P ∈ MvPolynomial.restrictSupport R {d | ∀ j, d j ≤ r j} := by\n  simp only [MvPolynomial.mem_restrictSupport_iff, Set.subset_def, Finset.mem_coe,\n    MvPolynomial.degreeOf_le_iff]\n  exact ⟨fun h d hd j ↦ h j d hd, fun h j d hd ↦ h d hd j⟩\n#print axioms degree_support_bridge\nend RSet179Isolated\n"
      },
