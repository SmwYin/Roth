        "code": "import Mathlib.Algebra.MonoidAlgebra.Degree\nimport Mathlib.Algebra.MvPolynomial.Eval\nimport Mathlib.Order.ConditionallyCompleteLattice.Finset\nimport Mathlib.Basic.Real.Basic\nimport Mathlib.Data.Finsupp.Weight\nimport Mathlib.RingTheory.MvPowerSeries.NoZeroDivisors\nimport Mathlib.Tactic\nimport Mathlib.Algebra.Polynomial.RingDivision\nimport Mathlib.Algebra.Polynomial.Taylor\nimport Mathlib.Algebra.MvPolynomial.NoZeroDivisors\nimport Mathlib.LinearAlgebra.FreeModule.PID\nimport Mathlib.RingTheory.MvPolynomial.Localization\nimport Mathlib.RingTheory.Localization.Integer\nimport Mathlib.RingTheory.Localization.FractionRing\nimport Mathlib.RingTheory.Polynomial.GaussLemma\n#check_failure Roth.Θ\n#check @SupSet.sSup\n#check @le_csSup\n#check @csSup_le\n#check @csSup_le_csSup\n#check @Real.sSup_nonneg\n#check @Real.sSup_le\n#check @sSup_image2\n#check @csSup_image\nnamespace Theta181Isolated\nuniverse u v w\nvariable {A : Type u} {H : Type v} {V : Type w}\nnoncomputable def generic [SupSet V] (s : Set V) : V := sSup s\ntheorem exact_sup [SupSet V] (s : Set V) : generic s = SupSet.sSup s := rfl\ntheorem member (f : A → H → ℝ) (s : Set A) (t : Set H)\n    (hb : BddAbove (Set.image2 f s t)) {a : A} (ha : a ∈ s) {h : H} (hh : h ∈ t) :\n    f a h ≤ sSup (Set.image2 f s t) := le_csSup hb (Set.mem_image2_of_mem ha hh)\ntheorem upper (f : A → H → ℝ) (s : Set A) (t : Set H)\n    (hne : (Set.image2 f s t).Nonempty) {c : ℝ}\n    (hc : ∀ a ∈ s, ∀ h ∈ t, f a h ≤ c) : sSup (Set.image2 f s t) ≤ c :=\n  csSup_le hne (Set.forall_mem_image2.mpr hc)\ntheorem empty : sSup (∅ : Set ℝ) = 0 := Real.sSup_empty\ntheorem unbounded {s : Set ℝ} (hs : ¬BddAbove s) : sSup s = 0 :=\n  Real.sSup_of_not_bddAbove hs\n#check_failure (inferInstance : CompleteLattice ℝ)\n#print axioms exact_sup\n#print axioms member\n#print axioms upper\n#print axioms empty\n#print axioms unbounded\nend Theta181Isolated\n"
